# ===============================
# Music Recommendation System
# Environment Configuration
# ===============================

# SECURITY WARNING: These are example values. Change all secrets before deployment!

# ===============================
# Server Configuration
# ===============================

# Port to run server on
PORT=5002

# Environment (development, staging, production)
NODE_ENV=development

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ===============================
# Database Configuration
# ===============================

# MongoDB connection URI
# Local: mongodb://localhost:27017/musicrecommendation
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/musicrecommendation
MONGODB_URI=mongodb://localhost:27017/musicrecommendation

# ===============================
# Authentication Configuration
# ===============================

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate: openssl rand -base64 32
JWT_SECRET=

# JWT Refresh Secret - CHANGE THIS IN PRODUCTION!
# Generate: openssl rand -base64 32
JWT_REFRESH_SECRET=

# Token expiration times
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cookie domain (for multi-domain support)
COOKIE_DOMAIN=localhost

# ===============================
# API Configuration
# ===============================

# Base URL for your API
API_BASE_URL=http://localhost:5002/api

# Allowed origins for CORS (comma-separated)
# Should NOT include wildcard (*) in production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# ===============================
# Cache Configuration (Redis)
# ===============================

# Redis connection string
# If not set, caching will be disabled
REDIS_URL=redis://localhost:6379
REDIS_CONNECTION=redis://localhost:6379

# ===============================
# File Upload Configuration
# ===============================

# Maximum file upload size (bytes)
MAX_FILE_SIZE=10485760

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/jpeg,image/png,audio/mpeg

# ===============================
# Email Configuration (for future use)
# ===============================

# SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# From email address
EMAIL_FROM=noreply@musicrecommender.com

# ===============================
# Third-Party Services
# ===============================

# Spotify API (optional)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Full-track uploads. Store on a persistent disk and back it up with MongoDB.
# Leave blank to use <project>/storage/audio.
AUDIO_STORAGE_DIR=
AUDIO_USER_QUOTA_MB=5120
AUDIO_USER_MAX_FILES=1000

# Sentry (error tracking) - optional
SENTRY_DSN=

# ===============================
# Development Only
# ===============================

# Set to true to seed database with test data
SEED_DATABASE=false

# ===============================
# IMPORTANT SECURITY NOTES
# ===============================

# 1. Commit only this example; NEVER commit the populated .env file
# 2. Use strong, randomly generated secrets for all keys
# 3. Rotate secrets regularly in production
# 4. Use a secrets manager (AWS Secrets, Hashicorp Vault, etc.)
# 5. Never share secrets in logs or error messages
# 6. Use HTTPS in production
# 7. Set secure cookies in production
